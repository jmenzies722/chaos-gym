# python
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
*.egg-info/

# go
*.test
/app/app

# terraform
# .terraform.lock.hcl is intentionally NOT ignored — it pins provider versions
# so a `terraform init` months from now resolves the same AWS provider that was
# actually tested here.
.terraform/
*.tfstate
*.tfstate.backup
terraform.tfvars

CLAUDE.local.md

# Raw capture from the Stop hook: every command run and its real output. It is
# redacted for credential patterns, but "redacted by regex" is not a guarantee,
# so the raw log never leaves this machine. portfolio.yaml — the distilled,
# reviewed version — is what gets committed and published.
.portfolio/sessions/
